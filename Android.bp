soong_namespace {
}

aidl_interface {
    name: "vendor.pixelworks.hardware.display",
    system_ext_specific: true,
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: ["aidl/vendor/pixelworks/hardware/display/*.aidl"],
    stability: "vintf",
    owner: "pixelworks",

    backend: {
        cpp: {
            enabled: true,
        },
        java: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}

aidl_interface {
    name: "vendor.pixelworks.hardware.feature",
    system_ext_specific: true,
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: ["aidl/vendor/pixelworks/hardware/feature/*.aidl"],
    stability: "vintf",
    owner: "pixelworks",

    backend: {
        cpp: {
            enabled: true,
        },
        java: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
        {
            version: "2",
            imports: [],
        },
    ],
}

hidl_package_root {
    name: "vendor.pixelworks",
    path: "hardware/pixelworks/interfaces",
}
