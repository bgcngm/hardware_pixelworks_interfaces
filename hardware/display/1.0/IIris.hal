package vendor.pixelworks.hardware.display@1.0;

import IIrisCallback;

import android.hidl.base@1.0::IBase;

interface IIris extends IBase {
    irisConfigureSet(int32_t type, vec<int32_t> values) generates (int32_t status);
    irisConfigureGet(int32_t type, vec<int32_t> values) generates (int32_t status, vec<int32_t> result);
    registerCallback(IIrisCallback callback) generates (int32_t status);
    registerCallback2(uint64_t callbackId, IIrisCallback callback) generates (int32_t status);
    panelReadWrite(bool highSpeed, uint8_t dtype, uint8_t vc, bool last, vec<uint8_t> tx, uint8_t rxLen)
            generates (int32_t status, vec<uint8_t> result);
    irisConfigureBatch(int32_t type, string json) generates (int32_t status, string result);
};
