struct LayerBuffer {
    int32_t width;
    int32_t height;
    int32_t unalignedWidth;
    int32_t unalignedHeight;
    ColorMetaData colorMetadata;
    int32_t acquireFenceFd;
    int32_t releaseFenceFd;
    int32_t flags;
    BufferHandle bufferHandle;
    BufferInfo bufferInfo;
};

enum LayerBufferType : int32_t {
    BUFFER_TYPE_UI = 0,
    BUFFER_TYPE_VIDEO = 1,
    BUFFER_TYPE_HW_VIDEO = 3,
    BUFFER_TYPE_HDR_VIDEO = 7,
};

enum LayerCompositionType : int32_t {
    COMPOSITION_TYPE_GPU = 0,
    COMPOSITION_TYPE_HWC = 2,
};

struct LayerRect {
    float left;
    float top;
    float right;
    float bottom;
};

struct LayerTransform {
    float rotation;
    bool flipHorizontal;
    bool flipVertical;
};

struct LutData {
    int32_t dim;
    int32_t gridSize;
    vec<int32_t> lutEntries;
    bool validLutEntries;
    vec<int32_t> gridEntries;
    bool validGridEntries;
};

