    TYPE_MAX_V1_1 = 530,
};

enum VendorConfig : int32_t {
    GET_SECONDARY_DISPLAY = 268, // Duplicate value with TYPE_MAX
    FRAME_RATE_CHANGED = 269,
    SET_LOW_LATENCY = 270,
    SET_FRAMEBUFFER_RESOLUTION = 271,
