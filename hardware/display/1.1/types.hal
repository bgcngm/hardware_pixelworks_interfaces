package vendor.pixelworks.hardware.display@1.1;

struct BufferInfo {
    int64_t id;
    int32_t format;
    int32_t type;
    int32_t flags;
    int32_t width;
    int32_t height;
    int32_t unalignedWidth;
    int32_t unalignedHeight;
    float refreshRate;
    int32_t frcEnable;
    int32_t frcCounter;
    int64_t frcTimestamp;
    vec<int32_t> reserved;
};

struct BufferHandle {
    vec<handle> data;
    vec<int32_t> ints;
};

struct ColorMetaData {
    int32_t colorPrimaries;
    int32_t range;
    int32_t transfer;
    bool lightLevelSEIEnabled;
    int32_t maxContentLightLevel;
    int32_t minPicAverageLightLevel;
    bool dynamicMetaDataValid;
    int32_t dynamicMetaDataLen;
    vec<int8_t> dynamicMetaDataPayload;
};

struct DisplayConfigVariableInfo {
    bool valid;
    int32_t xPixels;
    int32_t yPixels;
    float xDpi;
    float yDpi;
    int32_t fps;
    int64_t vsyncPeriodNs;
    bool isYuv;
    bool smartPanel;
    int32_t config;
    vec<int32_t> reserved;
};

enum DisplayType : int64_t {
    DISPLAY_PRIMARY = 0,
    DISPLAY_EXTERNAL = 1,
    DISPLAY_PLUGGABLE = 1,
    DISPLAY_VIRTUAL = 2,
    DISPLAY_BUILTIN_2 = 3,
    DISPLAY_SECONDARY = 3,
    DISPLAY_EXTERNAL_2 = 4,
    DISPLAY_MAX = 5,
};

enum DualChannelOsdStatus : int32_t {
    GET_STATE = 0,
    IS_OVERFLOW = 1,
};

enum DualChannelState : int32_t {
    PWRON_PREPARE = 0,
    PWRON = 1,
    CFGON_PRE = 2,
    CFGON = 3,
    CFGOFF_PRE = 4,
    CFGOFF = 5,
    PWROFF_PREPARE = 6,
    PWROFF = 7,
};

enum HdrFormalType : int32_t {
    HDR_FORMAL_NONE = 0,
    HDR_FORMAL_HDR_SDR = 1,
    HDR_FORMAL_HDR = 2,
    HDR_FORMAL_MEMC = 10,
    HDR_FORMAL_HDR_MEMC = 12,
    HDR_FORMAL_MEMC_DUAL2 = 40,
    HDR_FORMAL_HDR_MEMC_DUAL2 = 42,
};

struct HwcRect {
    int32_t left;
    int32_t top;
    int32_t right;
    int32_t bottom;
};

struct LayerStack {
    uint64_t displayId;
    vec<uint64_t> layerIds;
    uint32_t flags;
};

struct IrisFixedConfig {
    int32_t hdrFormal;
    vec<int32_t> hdrLut;
    int32_t memcEnable;
    int32_t memcLevel;
    int32_t dualChannel;
    int32_t movingLayer;
    int32_t memcVideoLayer;
    int32_t inMemcState;
    int32_t videoFps;
    int32_t videoInMemory;
    int32_t gameMode;
    int32_t captureDisable;
    int32_t dualPrepare;
    int32_t inOsdSwitch;
    int32_t dualPreload;
    int32_t metadataDone;
    int32_t memcToPt;
    int32_t clientCompRequest;
    int32_t hdrRequest;
    int32_t motionLayerIdUsing;
    int32_t testOption;
    int32_t activeTask;
    int32_t emvMvdId;
    int32_t emvGameId;
    int32_t pqSwitchType;
    vec<int32_t> reserved;
};

