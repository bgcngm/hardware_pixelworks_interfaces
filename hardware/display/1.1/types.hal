    PANEL_REFRESH_RATE = 521, // Duplicate value with TYPE_MAX
    PANEL_POWER_MODE = 522,
    WHITE_POINT_SHIFT = 523,
    PANEL_OEM_ID = 524,
    BRIGHTNESS_BLEND_CURVE = 525,
    CM_RATIO_SET = 526,
    PANEL_APL_VALUE = 527,
    SET_FEATURE = 528,
