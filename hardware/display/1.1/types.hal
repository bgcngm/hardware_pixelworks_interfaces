    DPORT_DIS_DEBUG = 160,
    HDR10PLUS = 161,
    SDR2HDR_AI_SWITCH = 162,
    DPP_3DLUT_GAIN = 163,
    SDR2HDR_AI_SWITCH_PRE = 165,
    SET_DSI_MODE_INFO = 167,
    OSD_LAYER_EMPTY = 168,
    SET_METADATA = 169,
    SET_METADATA_LOCK = 170,
    GET_METADATA = 171,
    DUAL_CH_CTRL = 172,
    MEMC_CTRL = 173,
    MEMC_INFO_SET = 174,
    DEBUG_SET = 175,
    DEBUG_GET = 176,
    KERNEL_STATUS_GET = 177,
    SET_MVD_META = 178,
    PWIL_DPORT_DISABLE = 189,
    HDR_DATA_PATH = 190,
    DPP_CSC_SET = 191,
    PT_SR_SET = 192,
    DEMURA_LUT_SET = 193,
    DEMURA_ENABLE = 194,
