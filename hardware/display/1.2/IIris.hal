package vendor.pixelworks.hardware.display@1.2;

import vendor.pixelworks.hardware.display@1.1::IIris;

interface IIris extends @1.1::IIris {
    irisConfigureBuffer(int32_t cmd, uint64_t displayId, handle buffer, int32_t size) generates (int32_t status);
    irisConfigureMemory(int32_t cmd, uint64_t displayId, memory mem) generates (int32_t status);
    setActiveConfig_1_2(uint64_t displayId, DisplayConfigVariableInfo_1_2 info);
    setLayerBuffer_1_2(uint64_t displayId, uint64_t layerId, handle buffer, int32_t acquireFence, BufferInfo_1_2 bufferInfo);
    getCurrentConfig_1_2(uint64_t displayId) generates (int32_t status, IrisFixedConfig_1_2 config);
};
